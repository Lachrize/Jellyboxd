# --- Database (SQLite by default; swap to a Postgres URL for production) ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign/seed session security. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Cookie name for the session token
SESSION_COOKIE="jellyboxd_session"

# --- Media provider ---
# If TMDB_API_KEY is set, Jellyboxd uses the live TMDB catalog.
# If empty, it transparently falls back to the bundled seed catalog (offline-friendly).
# Get a free key: https://www.themoviedb.org/settings/api  (v3 API key OR v4 read token)
TMDB_API_KEY=""
# Optional: force a provider regardless of the key ("tmdb" | "seed"). Leave empty for auto.
MEDIA_PROVIDER=""

# --- App ---
NEXT_PUBLIC_APP_NAME="Jellyboxd"
# Public URL of the app (used for links/redirects). In production set this to
# your real domain, e.g. http://192.168.1.50:3002 on a home NAS.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Jellyfin ---
# Jellyfin is configured per user in Paramètres -> Jellyfin (URL + API key).
# Jellyboxd must run on the same local network as Jellyfin (like Jellyseerr).
# Use the Jellyfin LAN address from Docker, e.g. http://192.168.1.50:8096 —
# not localhost if Jellyboxd runs in a container.
