# Copy this file to .env.docker on the NAS and edit the values.

# SQLite database persisted by docker-compose in ./data
DATABASE_URL="file:/app/data/jellyboxd.db"

# REQUIRED: at least 32 chars, never a placeholder (the app rejects weak/default
# values). Generate a strong value on the NAS:
# openssl rand -base64 32
AUTH_SECRET=""

SESSION_COOKIE="jellyboxd_session"

# Set this to the NAS URL users will open.
# Example: http://192.168.1.50:3002
NEXT_PUBLIC_APP_NAME="Jellyboxd"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# TMDB is recommended for real posters, search, cast and person pages.
TMDB_API_KEY=""

# Optional: "tmdb" or "seed"; leave empty for auto.
MEDIA_PROVIDER=""
