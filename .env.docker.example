# OPTIONAL. `docker compose up -d --build` works with NO .env.docker at all:
# the container auto-generates AUTH_SECRET and JELLYBOXD_SYNC_KEY on first run
# and persists them in ./data. Copy this file to .env.docker only to override.

# SQLite database persisted by docker-compose in ./data
DATABASE_URL="file:/app/data/jellyboxd.db"

# Leave empty to auto-generate (recommended). If you set it, use a strong value
# (>= 32 chars, never a placeholder): openssl rand -base64 32
AUTH_SECRET=""

SESSION_COOKIE="jellyboxd_session"

# Set this to the URL users will open (only needed if not http://localhost:3002).
# Example: http://192.168.1.50:3002
NEXT_PUBLIC_APP_NAME="Jellyboxd"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Recommended for real posters, search, cast and person pages.
TMDB_API_KEY=""

# Optional: "tmdb" or "seed"; leave empty for auto.
MEDIA_PROVIDER=""

# Shared secret the Jellyfin "Jellyboxd Sync" plugin uses (Bearer).
# Leave empty to auto-generate; the value is shown in Jellyboxd -> Paramètres
# -> Synchronisation Jellyfin (and in the Docker logs on start).
JELLYBOXD_SYNC_KEY=""
